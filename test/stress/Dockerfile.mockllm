FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /mockllm ./test/stress/mock/httpserver/

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=builder /mockllm /usr/local/bin/mockllm
EXPOSE 8999
ENTRYPOINT ["mockllm"]

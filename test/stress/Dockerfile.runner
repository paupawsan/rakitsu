FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Build the stress test binary with race detector
RUN CGO_ENABLED=1 apk add --no-cache gcc musl-dev && \
    go test -race -c -tags stress -o /stress-runner ./test/stress/

FROM alpine:3.21
RUN apk add --no-cache ca-certificates libc6-compat
COPY --from=builder /stress-runner /usr/local/bin/stress-runner
COPY --from=builder /app/test/stress/configs /configs
ENTRYPOINT ["stress-runner", "-test.v", "-test.timeout", "10m"]
